# Optional overrides for docker compose (all have defaults).
# MARKET_OVERRIDE=open     # force US equities open (demo trading outside market hours); or "closed"
# SNAPSHOT_SCHEDULE=every 5 minutes   # how often portfolio snapshots are taken in dev
# Real provider keys are not used yet (only FakeProvider is implemented):
# FINNHUB_API_KEY= TWELVE_DATA_API_KEY= COINGECKO_API_KEY=
