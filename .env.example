# Copy to deploy/.env (production-shaped stack) or export in your shell. Every secret comes from the environment (SEC-08).
# Never commit the real file; .gitignore and .dockerignore exclude it.

# --- Required in production ---
SECRET_KEY_BASE=            # bin/rails secret
DATABASE_URL=               # postgres://user:pass@host:5432/paper_broker_production
CACHE_DATABASE_URL=         # separate database for Solid Cache
QUEUE_DATABASE_URL=         # separate database for Solid Queue
ALLOWED_HOSTS=app.example.com        # comma separated; DNS rebinding protection (SEC-06)
ALLOWED_ORIGINS=https://app.example.com
APP_URL=https://app.example.com      # used in email links
TRUSTED_PROXIES=            # CIDRs of your load balancer, e.g. 203.0.113.0/24 (SEC-01)

# --- Sizing (OPS-05): WEB_PROCESSES x RAILS_MAX_THREADS + worker threads + 5 <= DB_POOL_LIMIT ---
RAILS_MAX_THREADS=3
WEB_PROCESSES=2
DB_POOL_LIMIT=95
JOB_CRITICAL_THREADS=2
JOB_DEFAULT_THREADS=3
JOB_LOW_THREADS=1

# --- Email (NTF-01) ---
MAIL_FROM="Paper Broker <no-reply@app.example.com>"
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Market data ---
COINGECKO_API_KEY=          # optional free demo key
YAHOO_MAX_PER_MIN=120       # provider budgets (MKD-06)
COINGECKO_MAX_PER_MIN=30

# --- Operations ---
METRICS_TOKEN=              # bearer token for GET /metrics; the endpoint is off when empty
FORCE_SSL=true
ASSUME_SSL=true

# --- Local development only (docker compose up) ---
# MARKET_OVERRIDE=open      # force US equities open outside market hours, or "closed"
# SNAPSHOT_SCHEDULE=every 5 minutes
# STARTING_CASH=100000
